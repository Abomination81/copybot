# Copy to deploy/copybot.env (ignored by Git); never commit the populated file.
# Required for live order signing. Set securely in the local environment file.
PRIVATE_KEY=

# Use matching ports and paths for the engine and all independent observers.
DASHBOARD_PORT=8807
BOT_PORT=8807
BOT_DIR=/opt/copybot
BOT_CONFIG=/opt/copybot/deploy/copybot2.toml
COPYBOT_API=http://127.0.0.1:8807
POOL_PAGE=/opt/copybot/deploy/dashboard/pool.html

# Populate these with YOUR funder and the relevant leader for the legacy watcher.
OUR_WALLET=
FILLWATCH_FUNDER=
WATCH_WALLET=
BOT_NAME=copybot
BOT_SERVICE=copybot-hot.service
BOT_PROCESS=copybot-hot
FILLWATCH_RPC=

# Guardian enforcement is an existing explicit switch; review before turning on.
GUARDIAN_ENFORCE=0

# Optional notifications. Never copy another operator's recipient or provider key.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_TZ=UTC

# Optional on-chain features retain their existing independent gates.
MERGE_RECONCILE=0
COPYBOT_MERGE_ENABLE=0
ORPHAN_SWEEP=0
