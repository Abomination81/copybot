[Unit]
Description=Abomination81 Copybot — independent production guardian
After=network-online.target copybot-hot.service copybot-watcher.service
Wants=network-online.target


[Service]
EnvironmentFile=/opt/copybot/deploy/copybot.env
Type=oneshot
User=copybot
Group=copybot
WorkingDirectory=/opt/copybot
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/copybot/deploy/guardian.py --once
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/copybot/run /opt/copybot/run

CapabilityBoundingSet=
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
