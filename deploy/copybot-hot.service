[Unit]
Description=Abomination81 Copybot — live trader (wallet-locked)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10


[Service]
Type=simple
User=copybot
Group=copybot
WorkingDirectory=/opt/copybot
EnvironmentFile=/opt/copybot/deploy/copybot.env
Environment=DASHBOARD_PORT=8807
ExecStart=/opt/copybot/bin/copybot-hot /opt/copybot/deploy/copybot2.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=copybot-hot
UMask=0027
NoNewPrivileges=true
PrivateTmp=false
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true


CapabilityBoundingSet=
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
