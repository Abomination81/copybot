[Unit]
Description=Copybot independent fill watcher
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/opt/copybot/deploy/copybot.env
Type=simple
User=copybot
Group=copybot
WorkingDirectory=/opt/copybot
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/copybot/deploy/watcher.py --grace 45
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/copybot/run
StandardOutput=append:/opt/copybot/run/watcher.log
StandardError=append:/opt/copybot/run/watcher.log


CapabilityBoundingSet=
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
